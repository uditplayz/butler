# ---- Ingest credentials (generated by scripts/init.sh) ------------------------------------
PUBLISH_USER=
PUBLISH_PASS=

# ---- Where to stream ----------------------------------------------------------------------
# Twitch: dashboard.twitch.tv -> Settings -> Stream -> Primary Stream key
TWITCH_STREAM_KEY=
# Pick the ingest closest to the SERVER from https://help.twitch.tv/s/twitch-ingest-recommendation
# rtmp://live.twitch.tv/app auto-selects one and is a fine default.
TWITCH_INGEST_URL=rtmp://live.twitch.tv/app

# YouTube: studio.youtube.com -> Go live -> Stream -> Stream key
YOUTUBE_STREAM_KEY=
YOUTUBE_INGEST_URL=rtmp://a.rtmp.youtube.com/live2

# Any other RTMP(S) targets, comma separated, full URL including key.
CUSTOM_RTMP_URLS=

# ---- Mode ---------------------------------------------------------------------------------
# resilient   : re-encode to a constant 1080p stream; shows a slate if the phone drops (recommended)
# passthrough : copy the phone's stream as-is (no CPU, but the stream ends when the phone drops
#               and the phone must send H.264 + AAC)
MODE=resilient

# ---- Output quality (resilient mode) ------------------------------------------------------
VIDEO_SIZE=1920x1080
VIDEO_FPS=30
VIDEO_BITRATE_KBPS=6000
AUDIO_BITRATE_KBPS=160
# veryfast suits a 4 vCPU server; use faster/ultrafast on 2 vCPU, medium on 8+ vCPU.
X264_PRESET=veryfast

# ---- Resilience tuning --------------------------------------------------------------------
# Show the slate after the phone has been silent this long (shorter blips just freeze the frame).
LIVE_STALL_SECONDS=3
# Extra smoothing buffer between phone and encoder, in milliseconds.
JITTER_MS=300
SLATE_TEXT=Be right back
SLATE_SUBTEXT=The stream will resume automatically
# Optional: path of a custom slate image inside the container, e.g. /data/slate.png
SLATE_IMAGE=

# ---- Internals (change only if ports clash) -----------------------------------------------
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_RTMP_PORT=1935
MEDIAMTX_API_PORT=9997
STATUS_BIND=127.0.0.1
STATUS_PORT=8080
LOG_LEVEL=INFO
